# Copy to studio/.env (git-ignored). Create the project at
# https://www.sanity.io/manage → "Create project" → choose the
# "Kshetra Tours (production)" dataset.
SANITY_STUDIO_PROJECT_ID=yourProjectId
SANITY_STUDIO_DATASET=production

# Only needed by the node scripts (npm run import / npm run verify):
# a token with write access, created under the project's API → "Add API token".
SANITY_TOKEN=yourWriteToken
